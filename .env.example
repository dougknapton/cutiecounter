# Copy to .env (or set these in Netlify / GitHub Actions) before building.
# The web app URL from Apps Script: Deploy > Manage deployments > Web app URL (ends in /exec)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
# Must match SHARED_TOKEN in the Apps Script project's Script Properties
VITE_APPS_SCRIPT_TOKEN=change-me-to-a-long-random-string
